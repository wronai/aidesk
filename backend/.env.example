# AI Desktop Assistant Configuration
# Skopiuj ten plik do .env i wypełnij swoimi kluczami API

# ===== WYMAGANE API KEYS =====

# Deepgram API Key (STT - Speech-to-Text)
# Zarejestruj się na https://deepgram.com (darmowe $200 kredytu)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Google Gemini API Key (Vision AI - POLECANE)
# Zarejestruj się na https://makersuite.google.com/app/apikey (darmowy tier)
GEMINI_API_KEY=your_gemini_api_key_here

# ===== OPCJONALNE API KEYS =====

# OpenAI API Key (alternatywny Vision AI)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key (najlepsza jakość, ale droższy)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===== KONFIGURACJA APLIKACJI =====

# Vision Provider: gemini | openai | claude
# Rekomendacja: gemini (najtańszy, 15-30x taniej niż konkurencja)
VISION_PROVIDER=gemini

# Model dla każdego providera
GEMINI_MODEL=gemini-2.0-flash-exp
OPENAI_MODEL=gpt-4o-mini
CLAUDE_MODEL=claude-sonnet-4-20250514

# STT Language (pl dla polskiego)
STT_LANGUAGE=pl

# STT Model
DEEPGRAM_MODEL=nova-3

# ===== PARAMETRY WYDAJNOŚCI =====

# Change Detection Threshold (1-20)
# Niższa wartość = więcej wykrytych zmian = wyższe koszty API
# Wyższa wartość = mniej wykrytych zmian = niższe koszty, ale może pominąć istotne zmiany
# Rekomendacja: 8 (dobry balans)
CHANGE_THRESHOLD=8

# Minimum Capture Interval (sekundy)
# Jak często robić zrzuty ekranu
# Rekomendacja: 1.0 dla responsywności, 2.0 dla oszczędności
MIN_CAPTURE_INTERVAL=1.0

# Idle Interval Multiplier
# Po ilu niezmiennych klatkach zwiększyć interwał
# np. po 30 niezmiennych klatkach (30 sekund), przejdź na sprawdzanie co 10s
IDLE_THRESHOLD=30
IDLE_INTERVAL=10.0

# Screen Resolution (width, height)
# Niższa rozdzielczość = mniej tokenów = niższe koszty
# 1920x1080 -> ~1600 tokenów
# 1280x720 -> ~1100 tokenów (rekomendacja)
# 960x540 -> ~700 tokenów
SCREEN_WIDTH=1280
SCREEN_HEIGHT=720

# JPEG Quality (1-100)
# Niższa jakość = mniejsze pliki = szybszy upload
# 60 = dobry balans między jakością a rozmiarem
JPEG_QUALITY=60

# ===== FEATURE FLAGS =====

# Włącz/wyłącz STT (Speech-to-Text)
ENABLE_STT=true

# Włącz/wyłącz Vision AI
ENABLE_VISION=true

# Verbose Logging
DEBUG=false

# ===== RATE LIMITING =====

# Max API calls per minute
MAX_VISION_CALLS_PER_MINUTE=30
MAX_STT_CALLS_PER_MINUTE=60

# Token bucket settings
RATE_LIMIT_TOKENS=5
RATE_LIMIT_REFILL_RATE=1.0

# ===== CONTEXT MANAGEMENT =====

# Max context history items
MAX_CONTEXT_ITEMS=20

# Context summary interval (ile itemów zanim zrobić podsumowanie)
CONTEXT_SUMMARY_INTERVAL=50

# ===== SERVER SETTINGS =====

# Backend port
PORT=8000

# Host (0.0.0.0 dla dostępu z sieci, 127.0.0.1 tylko localhost)
HOST=127.0.0.1

# CORS origins (oddzielone przecinkami)
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ===== LOGGING =====

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/assistant.log

# Usage stats file
USAGE_LOG_FILE=logs/usage.log
