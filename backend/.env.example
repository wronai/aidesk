# Proxeen Assistant Configuration
# Skopiuj ten plik do .env i wypełnij swoimi kluczami API
# Pełna dokumentacja providerów: PROVIDERS.md

# ===== VISION MODEL (LiteLLM) =====
# Format: "provider/model-name" — LiteLLM routuje do właściwego API
# Dokumentacja modeli: https://docs.litellm.ai/docs/providers
#
# Lokalne (zero kosztów, wymaga uruchomionego serwera):
#   VISION_MODEL=ollama/llava              ← Ollama (domyślne)
#   VISION_MODEL=ollama/llava:13b          ← Ollama, większy model
#   VISION_MODEL=ollama/bakllava           ← Ollama BakLLaVA
#   VISION_MODEL=ollama/llava-phi3         ← Ollama LLaVA-Phi3 (lekki)
#   VISION_MODEL=openai/local-model        ← LM Studio / vLLM / llama.cpp (ustaw LITELLM_API_BASE)
#
# Zdalne (wymagają kluczy API):
#   VISION_MODEL=gemini/gemini-2.0-flash   ← Google Gemini (najtańszy cloud)
#   VISION_MODEL=gpt-4o-mini               ← OpenAI
#   VISION_MODEL=anthropic/claude-sonnet-4-20250514 ← Anthropic Claude
#   VISION_MODEL=groq/llava-v1.5-7b-4096-preview   ← Groq (szybki, darmowy tier)
#   VISION_MODEL=deepseek/deepseek-chat    ← DeepSeek
#   VISION_MODEL=mistral/pixtral-12b-2409  ← Mistral Pixtral
VISION_MODEL=openrouter/qwen/qwen2.5-vl-72b-instruct:free
#VISION_MODEL=openrouter/nvidia/nemotron-nano-12b-v2-vl:free
#VISION_MODEL=openrouter/qwen/qwen3-vl-30b-a3b-thinking
#VISION_MODEL=openrouter/google/gemma-3-27b-it:free
#VISION_MODEL=openrouter/
OPENROUTER_API_KEY=sk-or-v1
# Rate limiting — darmowe modele mają limity
MAX_VISION_CALLS_PER_MINUTE=10  # Darmowe = max ~20 req/min
RATE_LIMIT_TOKENS=3
RATE_LIMIT_REFILL_RATE=0.5

# Wydajność — zmniejsz liczbę wywołań API
CHANGE_THRESHOLD=10            # Wyższy = mniej wywołań
MIN_CAPTURE_INTERVAL=2.0       # Rzadszy capture
IDLE_THRESHOLD=20
IDLE_INTERVAL=15.0

# Rozdzielczość — niższa = mniej tokenów
SCREEN_WIDTH=1280
SCREEN_HEIGHT=720
JPEG_QUALITY=60

# Custom API base URL (dla LM Studio, vLLM, llama.cpp, Text Generation WebUI)
# Przykład: LITELLM_API_BASE=http://localhost:1234/v1
LITELLM_API_BASE=

# Custom API key override (nadpisuje klucz specyficzny dla providera)
LITELLM_API_KEY=sk-or-v1


# Parametry Vision AI
VISION_MAX_TOKENS=400
VISION_TEMPERATURE=0.3
VISION_IMAGE_DETAIL=low

# ===== TRYB ANALIZY =====
# Jak analizować zrzuty ekranu:
#   vision_only      - Tylko VLM (obraz → LLM, oryginalne zachowanie)
#   ocr_only         - Tylko OCR (najszybszy, bez LLM, zero kosztów API)
#   hybrid           - OCR tekst → LLM (rekomendowany, 5-10x szybszy niż vision)
#   ocr_plus_vision  - OCR tekst + obraz → VLM (najdokładniejszy, najdroższy)
ANALYSIS_MODE=hybrid

# ===== OCR ENGINES =====
# Domyślny silnik OCR: paddleocr | easyocr | tesseract
# PaddleOCR: Najszybszy (~12.7 FPS GPU), najlepszy na UI/screenshoty
# EasyOCR: Wysoka dokładność (CER 0.09), dobry na mieszany tekst
# Tesseract: Najlżejszy (~10MB), szybki na prosty tekst
OCR_ENGINE=paddleocr

# Języki OCR (oddzielone przecinkami)
OCR_LANGUAGES=pl,en

# Użyj GPU dla OCR (wymaga CUDA)
OCR_USE_GPU=false

# Włącz/wyłącz OCR pre-processing
ENABLE_OCR=true

# ===== API KEYS (wymagane tylko dla zdalnych providerów) =====

# Google Gemini — https://makersuite.google.com/app/apikey (darmowy tier)
GEMINI_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Groq — https://console.groq.com/keys (darmowy tier)
GROQ_API_KEY=

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Mistral — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Deepgram (STT) — https://deepgram.com (darmowe $200 kredytu)
DEEPGRAM_API_KEY=

# STT Language (pl dla polskiego)
STT_LANGUAGE=pl

# STT Model
DEEPGRAM_MODEL=nova-3

# ===== URZĄDZENIA AUDIO =====
# Nazwy urządzeń PulseAudio/PipeWire (puste = domyślne systemowe)
# Lista dostępnych urządzeń: pactl list short sources / sinks
# Lub w przeglądarce: http://localhost:8000/config/ui

# Mikrofon — źródło wejściowe do nagrywania głosu (STT)
# Przykład: STT_INPUT_DEVICE=alsa_input.usb-Generic_USB_Audio-00.iec958-stereo
STT_INPUT_DEVICE=

# Monitor głośnika — przechwytywanie dźwięku z głośnika do STT (loopback)
# Służy do transkrypcji rozmów, spotkań, filmów, muzyki
# Przykład: STT_MONITOR_DEVICE=alsa_output.pci-0000_01_00.1.hdmi-stereo.monitor
STT_MONITOR_DEVICE=

# Głośnik — urządzenie wyjściowe audio
# Przykład: AUDIO_OUTPUT_DEVICE=alsa_output.pci-0000_01_00.1.hdmi-stereo
AUDIO_OUTPUT_DEVICE=

# ===== TTS (Text-to-Speech) =====
# Silniki TTS: auto | piper | pico2wave | rhvoice | flite | spd-say | festival | espeak-ng | espeak
# auto (domyślne) wybiera najwyższą dostępną jakość i unika espeak/espeak-ng,
# jeśli dostępne są lepsze silniki.
TTS_ENGINE=auto

# Opcjonalna ścieżka do modelu Piper (.onnx)
# Puste = auto-wyszukiwanie w ~/.local/share/piper, /usr/local/share/piper, /usr/share/piper
TTS_PIPER_MODEL=

# ===== PARAMETRY WYDAJNOŚCI =====

# Change Detection Threshold (1-20)
# Niższa wartość = więcej wykrytych zmian = wyższe koszty API
# Wyższa wartość = mniej wykrytych zmian = niższe koszty, ale może pominąć istotne zmiany
# Rekomendacja: 8 (dobry balans)
CHANGE_THRESHOLD=8

# Minimum Capture Interval (sekundy)
# Jak często robić zrzuty ekranu
# Rekomendacja: 1.0 dla responsywności, 2.0 dla oszczędności
MIN_CAPTURE_INTERVAL=1.0

# Idle Interval Multiplier
# Po ilu niezmiennych klatkach zwiększyć interwał
# np. po 30 niezmiennych klatkach (30 sekund), przejdź na sprawdzanie co 10s
IDLE_THRESHOLD=30
IDLE_INTERVAL=10.0

# Screen Resolution (width, height)
# Niższa rozdzielczość = mniej tokenów = niższe koszty
# 1920x1080 -> ~1600 tokenów
# 1280x720 -> ~1100 tokenów (rekomendacja)
# 960x540 -> ~700 tokenów
SCREEN_WIDTH=1280
SCREEN_HEIGHT=720

# JPEG Quality (1-100)
# Niższa jakość = mniejsze pliki = szybszy upload
# 60 = dobry balans między jakością a rozmiarem
JPEG_QUALITY=60

# ===== FEATURE FLAGS =====

# Włącz/wyłącz STT (Speech-to-Text)
ENABLE_STT=true

# Włącz/wyłącz Vision AI
ENABLE_VISION=true

# Włącz/wyłącz Window Awareness (wymaga xdotool, xprop, xrandr na Linux)
ENABLE_WINDOW_AWARE=true

# Włącz/wyłącz Shell Agent (sugerowane akcje + bezpieczne wykonywanie komend)
ENABLE_SHELL_AGENT=true

# Tryb capture: fullscreen | window
# fullscreen = cały ekran (domyślny)
# window = tylko aktywne okno (ROI) — wymaga ENABLE_WINDOW_AWARE=true
CAPTURE_MODE=fullscreen

# Verbose Logging
DEBUG=false

# ===== WINDOW AWARENESS =====

# Włącz kontekst Git (branch, status) dla IDE/Terminal
ENABLE_GIT_CONTEXT=true

# Timeout dla komend git (sekundy)
GIT_TIMEOUT=2.0

# Cache TTL dla detekcji okna (sekundy, niższe = częstsze odpytywanie xdotool)
WINDOW_CACHE_TTL=0.5

# ===== SHELL AGENT =====

# Auto-execute bezpiecznych komend (read-only) bez pytania
AGENT_AUTO_EXECUTE=true

# Maksymalna długość wyjścia komendy (znaki)
AGENT_MAX_OUTPUT=2000

# Timeout dla komend agenta (sekundy)
AGENT_TIMEOUT=10.0

# ===== PROCESS SCANNER & WINDOW CROPPER =====

# Katalog na wycięte zrzuty per-aplikacja
CROPS_DIR=/tmp/aidesk_crops

# Minimalny rozmiar okna do przycięcia (piksele, pomija małe okna)
MIN_WINDOW_SIZE=100

# Top-K: max okien do przycięcia (0 = wszystkie, >0 = najważniejsze K)
# Zmniejsza CPU/I/O gdy otwartych jest dużo okien
MAX_CROP_WINDOWS=0

# ===== PIPELINE PROFILES (optymalizacja czasu wykonywania) =====

# Profil pipeline: auto | fast | normal | full
# auto (domyślny) = adaptacyjny wybór per tick
# fast    = skip cropping, cached scan, OCR-only (najszybszy)
# normal  = cached scan, top-K crops, hybrid (zbalansowany)
# full    = pełny scan, crop all, głęboka analiza (najdokładniejszy)
PIPELINE_PROFILE=

# Interwał wymuszania pełnego skanu (sekundy, dotyczy trybu auto)
PIPELINE_FULL_INTERVAL=60.0

# Cache TTL dla skanowania okien (sekundy; FAST/NORMAL używa cache)
SCAN_CACHE_TTL=3.0

# ===== ZAPIS NA DYSK (I/O) =====

# Zapisuj captures na dysk (false = mniej I/O, brak historii zrzutów)
SAVE_CAPTURES=true

# Zapisuj crops na dysk (false = mniej I/O, brak plików per-app)
SAVE_CROPS=true

# ===== RATE LIMITING =====

# Max API calls per minute
MAX_VISION_CALLS_PER_MINUTE=30
MAX_STT_CALLS_PER_MINUTE=60

# Token bucket settings
RATE_LIMIT_TOKENS=5
RATE_LIMIT_REFILL_RATE=1.0

# ===== CONTEXT MANAGEMENT =====

# Max context history items
MAX_CONTEXT_ITEMS=20

# Context summary interval (ile itemów zanim zrobić podsumowanie)
CONTEXT_SUMMARY_INTERVAL=50

# ===== SERVER SETTINGS =====

# Backend port
PORT=8000

# Host (0.0.0.0 dla dostępu z sieci, 127.0.0.1 tylko localhost)
HOST=127.0.0.1

# CORS origins (oddzielone przecinkami)
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ===== TIER 1: MULTI-MONITOR INTELLIGENCE =====

# Analizuj tylko aktywny monitor (true = oszczędność 60-80% kosztów API)
MULTI_MONITOR_ACTIVE_ONLY=true

# Generuj opis monitorów dla LLM ("left: ide, right: terminal")
MULTI_MONITOR_DESCRIPTION=true

# ===== TIER 1: SEMANTIC MEMORY =====

# Włącz semantyczną pamięć (wymaga sentence-transformers, fallback na keyword search)
ENABLE_SEMANTIC_MEMORY=true

# Model embeddingów (domyślny: all-MiniLM-L6-v2, 384 dim, ~80MB)
SEMANTIC_MODEL=

# Ścieżka do bazy pamięci semantycznej
SEMANTIC_MEMORY_DB=logs/semantic_memory.db

# Max pamięci w bazie (auto-prune najstarszych)
SEMANTIC_MAX_MEMORIES=5000

# Ile pamięci przywołać na zapytanie
SEMANTIC_RECALL_K=3

# Min podobieństwo kosinusowe (0.0-1.0)
SEMANTIC_THRESHOLD=0.3

# Auto-kompresja pamięci starszych niż X godzin
SEMANTIC_COMPRESS_HOURS=1.0

# ===== TIER 1: ACTION TEMPLATES (uczenie się z aprobat) =====

# Włącz uczenie się wzorców akcji
ENABLE_ACTION_TEMPLATES=true

# Baza danych szablonów akcji
ACTION_TEMPLATES_DB=logs/action_templates.db

# Po ilu aprobach auto-execute (0 = nigdy)
ACTION_AUTO_APPROVE_AFTER=3

# ===== TIER 1: OCR POST-PROCESSING =====

# Włącz korekcję OCR (0→O, 1→l, spell check)
ENABLE_OCR_POST_PROCESS=true

# Spell check dla tekstu (wymaga symspellpy)
OCR_SPELL_CHECK=true

# Max dystans edycji dla spell check
OCR_MAX_EDIT_DISTANCE=2

# ===== TIER 1: PREDICTIVE PRE-FETCHING =====

# Włącz predykcję przełączeń okien
ENABLE_PREDICTIVE=true

# Min pewność predykcji do uruchomienia pre-fetch (0.0-1.0)
PREDICTIVE_THRESHOLD=0.6

# Max historia przejść
PREDICTIVE_MAX_HISTORY=1000

# TTL cache pre-fetch (sekundy)
PREDICTIVE_PREFETCH_TTL=10.0

# Min obserwacji przed rozpoczęciem predykcji
PREDICTIVE_MIN_OBS=3

# ===== EVENT SOURCING & CQRS =====

# Włącz event store (SQLite persystencja wszystkich eventów pipeline)
ENABLE_EVENT_STORE=true

# Ścieżka do bazy eventów
EVENT_STORE_DB=logs/events.db

# ===== LOGGING =====

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/assistant.log

# Usage stats file
USAGE_LOG_FILE=logs/usage.log
